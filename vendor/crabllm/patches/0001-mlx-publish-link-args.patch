+///
+/// Cargo scopes `cargo:rustc-link-arg` to the package that emits it, so a
+/// binary in a *dependent* package links without these flags: it finds no
+/// symbols in `libCrabllmMlx.a` and no rpath for the Swift runtime. This
+/// crate declares `links = "crabllm_mlx"`, so everything collected here is
+/// published as `cargo:link_args=...` and arrives in a dependent's build
+/// script as `DEP_CRABLLM_MLX_LINK_ARGS`, newline-separated, to be re-emitted
+/// there.
+fn link_arg(collected: &mut Vec<String>, arg: String) {
+    println!("cargo:rustc-link-arg={arg}");
+    collected.push(arg);
+}
