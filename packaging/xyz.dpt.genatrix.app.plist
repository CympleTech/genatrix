<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The launch agent inside Genatrix.app (design 09, "第一次打开就是装好").
     The shell registers it with SMAppService on the first open from the
     Finder. KeepAlive with SuccessfulExit false: a crash is restarted, a quit
     from the menu, which exits cleanly, is not. The core's log is opened by
     the shell in ~/Library/Logs/Genatrix, since a plist cannot name a home. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>xyz.dpt.genatrix.app</string>
  <key>BundleProgram</key>
  <string>Contents/MacOS/genatrix-menubar</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
</dict>
</plist>
